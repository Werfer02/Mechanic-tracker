FROM node:22-bookworm-slim AS build

WORKDIR /app

RUN corepack enable
RUN corepack prepare pnpm@11.3.0 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json tsconfig.json ./
COPY artifacts/mechanic-desktop/package.json artifacts/mechanic-desktop/package.json
COPY lib/api-client-react/package.json lib/api-client-react/package.json
COPY lib/api-zod/package.json lib/api-zod/package.json

RUN pnpm install --frozen-lockfile --ignore-scripts
RUN pnpm rebuild esbuild

COPY artifacts/mechanic-desktop artifacts/mechanic-desktop
COPY lib/api-client-react lib/api-client-react
COPY lib/api-zod lib/api-zod
COPY attached_assets attached_assets

RUN PORT=4173 BASE_PATH=/ NODE_ENV=production pnpm --filter @workspace/mechanic-desktop run build

FROM nginx:1.27-alpine

COPY --from=build /app/artifacts/mechanic-desktop/dist/public /usr/share/nginx/html
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
